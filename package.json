{
  "name": "cap-okf",
  "version": "0.0.0",
  "description": "CAP plugin that turns a CDS model and curated Markdown into an Open Knowledge Format (OKF) bundle, with opt-in serving",
  "license": "Apache-2.0",
  "main": "cds-plugin.js",
  "files": [
    "cds-plugin.js",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "@sap/cds": ">=10"
  },
  "peerDependenciesMeta": {
    "@cap-js/mcp": {
      "optional": true
    },
    "@gavdi/cap-mcp": {
      "optional": true
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "jest",
    "test:update-golden": "UPDATE_GOLDEN=1 jest test/golden",
    "check": "npm run lint && npm test",
    "demo": "npm run watch --workspace=demo",
    "demo:build": "npm run build --workspace=demo"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/demo/gen/"
    ]
  },
  "keywords": [
    "cap",
    "cds",
    "sap",
    "okf",
    "open-knowledge-format",
    "mcp",
    "ai-agents"
  ],
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.1.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@sap/cds": "^10.2.2",
    "@sap/cds-dk": "^10.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "workspaces": [
    "demo"
  ]
}
