{
  "name": "cap-okf",
  "version": "0.0.0",
  "description": "CAP plugin that turns a CDS model and curated Markdown into an Open Knowledge Format (OKF) bundle, with opt-in serving",
  "license": "Apache-2.0",
  "main": "cds-plugin.js",
  "files": [
    "cds-plugin.js",
    "lib/",
    "srv/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "@sap/cds": ">=10"
  },
  "peerDependenciesMeta": {
    "@cap-js/mcp": {
      "optional": true
    },
    "@gavdi/cap-mcp": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:timing": "jest --testNamePattern \"\\(timing\\)\"",
    "test:integrations": "jest test/contract",
    "test:update-golden": "UPDATE_GOLDEN=1 jest test/golden",
    "pilot:score": "node test/pilot/score.js",
    "check": "npm run format && npm run typecheck && npm run lint && npm test",
    "demo": "npm run build && npm run watch --workspace=demo",
    "demo:build": "npm run build && npm run build --workspace=demo",
    "cds:okf": "npm run build && node scripts/cds-with-okf.js",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "keywords": [
    "cap",
    "cds",
    "sap",
    "okf",
    "open-knowledge-format",
    "mcp",
    "ai-agents"
  ],
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3.1.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@sap/cds": "^10.2.2",
    "@sap/cds-dk": "^10.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "workspaces": [
    "demo"
  ],
  "types": "lib/index.d.ts"
}
