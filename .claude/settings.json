{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["cds-mcp"],
  "permissions": {
    "allow": [
      "mcp__cds-mcp",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx jest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx cds:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(git fetch:*)",
      "Bash(git pull --rebase origin main)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm add:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(git rebase:*)",
      "Bash(npm run test:update-golden:*)",
      "WebFetch"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(git tag:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push origin main:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-paths.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-file.mjs\"" }
        ]
      }
    ]
  }
}
